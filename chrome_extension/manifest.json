{
  "manifest_version": 3,
  "name": "IR Center Local Assistant",
  "version": "1.1.0",
  "description": "Connects the local DOCX assistant to your existing Chrome session on IR Center.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://ircenter.gov.ua/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://ircenter.gov.ua/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_popup": "popup.html"}
}
