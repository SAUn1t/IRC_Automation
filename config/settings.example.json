{
  "docx_folder": "~/Documents/IRCenter",
  "filename_patterns": [
    "{Surname} {Name}.docx",
    "{Name} {Surname}.docx",
    "{Surname}_{Name}.docx"
  ],
  "website_url": "https://ircenter.gov.ua/irc/index/conclusions-school",
  "browser": "chrome",
  "browser_transport": "cdp",
  "browser_executable": null,
  "browser_headless": false,
  "browser_profile": "~/.ircenter-automation/browser-profile",
  "timeout_ms": 10000,
  "review_before_submit": true,
  "auto_submit": false,
  "dry_run": true,
  "manual_review_only": true,
  "mapping_file": "field_mapping.json",
  "selectors": {
    "navigation_mode": "conclusions_list",
    "auth_indicator": "a[href='/logout']",
    "list_table": "table.zebra-stripe.list",
    "result_rows": "table.zebra-stripe.list tr:has(td)",
    "next_results_page": "#pagination-digg a:has-text('Далі')",
    "result_full_name": "td:nth-child(2) a",
    "result_name_format": "surname_first_patronymic",
    "result_open": "td:nth-child(2) a",
    "result_action": "td:nth-child(8) a.with-icon",
    "record_full_name": "table.zebra-stripe.list tr:has(td:first-child:text-is(\"Прізвище, ім'я, по батькові дитини\")) td:nth-child(2)",
    "record_name_format": "surname_first_patronymic",
    "add_form_button": "a.add-link.with-icon[href^='/irc/index/filling-ipr/conclusion_id/']",
    "ipr_row_add_button": "table.zebra-stripe.list tr:has(td) td:nth-child(5) a.with-icon[href^='/irc/index/filling-ipr/ipr_id/']:has(img[src$='/add.png'])",
    "form_root": "#iprForm",
    "form_heading": "#content-wrapper .nosidebar > h1",
    "form_heading_text": "Створення індивідуальної програми розвитку учня закладу загальної середньої освіти",
    "form_child_full_name": "#iprForm p:has-text('прізвище, власне ім’я, по батькові')",
    "form_child_name_format": "surname_first_patronymic",
    "submit_button": "#iprForm input[type='submit'][value='Сформувати документ']",
    "success_indicator": "REPLACE_AFTER_DOM_INSPECTION",
    "validation_error": "REPLACE_AFTER_DOM_INSPECTION"
  }
}
